{
  "name": "ai-studio-ghrab",
  "version": "0.20.1",
  "private": true,
  "description": "Profesionální federované PWA osmi chráněných školních aplikací včetně Lesson Hubu, manuálů, řízeného přístupu a jednotné GHRAB QA brány",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-registry.mjs && node scripts/generate-ai-readiness.mjs",
    "sync:offline": "node scripts/sync-registry.mjs --offline && node scripts/generate-ai-readiness.mjs",
    "build": "npm run generate:changelog && node scripts/verify-ai-core.mjs && node scripts/generate-ai-readiness.mjs && node scripts/build.mjs",
    "test": "npm run generate:changelog && npm run format:check && node scripts/verify-ai-core.mjs && node scripts/generate-ai-readiness.mjs && node scripts/test.mjs",
    "check": "node scripts/verify-ai-core.mjs && node scripts/generate-ai-readiness.mjs && node scripts/test.mjs",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "format": "node scripts/verify-ai-core.mjs && prettier --ignore-path .prettierignore --write \"src/**/*.{js,css,html,json,webmanifest,md}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.md\" \"package.json\"",
    "format:check": "node scripts/verify-ai-core.mjs && prettier --ignore-path .prettierignore --check \"src/**/*.{js,css,html,json,webmanifest,md}\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.md\" \"package.json\"",
    "qa:technical": "node scripts/qa-technical.mjs",
    "qa:security": "node scripts/qa-security.mjs",
    "qa:pwa": "node scripts/qa-pwa.mjs",
    "qa:critical": "node scripts/qa-critical.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "qa:report": "node scripts/qa-report.mjs",
    "qa:approve": "node scripts/qa-approve.mjs",
    "qa:release": "node scripts/qa-release.mjs",
    "qa:combinatorial": "node scripts/qa-combinatorial.mjs",
    "verify:ai-core": "node scripts/verify-ai-core.mjs",
    "readiness": "node scripts/generate-ai-readiness.mjs",
    "core:dispatch": "node scripts/dispatch-ai-core.mjs --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5"
  }
}
