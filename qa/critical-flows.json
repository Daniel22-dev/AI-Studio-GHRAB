{
  "flows": [
    {
      "id": "STUDIO-OPEN",
      "name": "Otevření centrálního rozcestníku",
      "type": "browser",
      "url": "/index.html",
      "expectedText": "AI Studio GHRAB",
      "steps": [
        {
          "action": "clickIfVisible",
          "selector": "#studio-startup-skip",
          "timeout": 5000
        },
        {
          "action": "wait",
          "ms": 650
        },
        {
          "action": "assertVisible",
          "selector": "main#main"
        }
      ]
    },
    {
      "id": "STUDIO-CHROME-CONTROLS",
      "name": "Sdílená tlačítka navigace, nastavení a jazyka reagují",
      "type": "browser",
      "url": "/index.html",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "expectedText": "AI Studio GHRAB",
      "steps": [
        {
          "action": "click",
          "selector": ".nav-toggle"
        },
        {
          "action": "assertVisible",
          "selector": ".main-nav.open"
        },
        {
          "action": "click",
          "selector": ".settings-toggle"
        },
        {
          "action": "assertVisible",
          "selector": ".settings-panel"
        },
        {
          "action": "click",
          "selector": "[data-lang=\"en\"]"
        },
        {
          "action": "assertText",
          "selector": "body",
          "text": "Applications"
        },
        {
          "action": "click",
          "selector": "[data-lang=\"cs\"]"
        },
        {
          "action": "assertText",
          "selector": "body",
          "text": "Aplikace"
        }
      ]
    },
    {
      "id": "STUDIO-CACHE-ISOLATION",
      "name": "Service worker nemaže cizí cache",
      "type": "static",
      "assertions": [
        {
          "file": "src/sw.js",
          "regex": "CACHE_PREFIXES\\s*=\\s*\\[[\\s\\S]*ghrab-ai-studio-v[\\s\\S]*\\][\\s\\S]*CACHE_PREFIXES\\.some\\(\\(prefix\\)\\s*=>\\s*key\\.startsWith\\(prefix\\)\\)",
          "message": "Aktivace service workeru není omezena na vlastní prefix."
        }
      ]
    },
    {
      "id": "STUDIO-ACTIVA-INTEGRATION",
      "name": "ACTIVA je v registru, politice a manuálech",
      "type": "static",
      "assertions": [
        {
          "file": "src/config/apps.fallback.json",
          "regex": "\\\"id\\\"\\s*:\\s*\\\"activity-builder\\\"",
          "message": "Fallback registr neobsahuje ACTIVA."
        },
        {
          "file": "src/config/access-policy.json",
          "regex": "\\\"trainingCode\\\"\\s*:\\s*\\\"ACT-01\\\"",
          "message": "ACTIVA nemá školení ACT-01."
        },
        {
          "file": "src/manualy/manualy.js",
          "regex": "activity-builder",
          "message": "Centrum manuálů nemá obsah ACTIVA."
        }
      ]
    },
    {
      "id": "STUDIO-SORTIO-INTEGRATION",
      "name": "SORTIO je v registru, politice a manuálech",
      "type": "static",
      "assertions": [
        {
          "file": "src/config/apps.fallback.json",
          "regex": "\\\"id\\\"\\s*:\\s*\\\"sortio\\\"",
          "message": "Fallback registr neobsahuje SORTIO."
        },
        {
          "file": "src/config/sources.json",
          "regex": "SORTIO/studio-manifest\\.json",
          "message": "Zdroje neobsahují manifest SORTIO."
        },
        {
          "file": "src/config/access-policy.json",
          "regex": "\\\"trainingCode\\\"\\s*:\\s*\\\"SOR-01\\\"",
          "message": "SORTIO nemá školení SOR-01."
        },
        {
          "file": "src/manualy/manualy.js",
          "regex": "sortio",
          "message": "Centrum manuálů nemá obsah SORTIO."
        },
        {
          "file": "src/assets/apps/sortio.svg",
          "regex": ".",
          "flags": "s",
          "message": "Chybí ikona SORTIO."
        }
      ]
    },
    {
      "id": "STUDIO-LESSON-HUB-INTEGRATION",
      "name": "Lesson Hub je v registru, politice, manuálech a telemetrii",
      "type": "static",
      "assertions": [
        {
          "file": "src/config/apps.fallback.json",
          "regex": "\\\"id\\\"\\s*:\\s*\\\"lesson-hub\\\"",
          "message": "Fallback registr neobsahuje Lesson Hub."
        },
        {
          "file": "src/config/sources.json",
          "regex": "lesson-hub/studio-manifest\\.json",
          "message": "Zdroje neobsahují manifest Lesson Hubu."
        },
        {
          "file": "src/config/access-policy.json",
          "regex": "\\\"trainingCode\\\"\\s*:\\s*\\\"LHB-01\\\"",
          "message": "Lesson Hub nemá školení LHB-01."
        },
        {
          "file": "src/manualy/manualy.js",
          "regex": "lesson-hub",
          "message": "Centrum manuálů nemá obsah Lesson Hubu."
        },
        {
          "file": "src/access/app-guard.js",
          "regex": "lesson-record[\\s\\S]*backup-export",
          "message": "Access Guard nemá povolené anonymní metriky Lesson Hubu."
        },
        {
          "file": "src/report/report.js",
          "regex": "lesson-hub[\\s\\S]*backup-export",
          "message": "Pilotní report nezná Lesson Hub."
        },
        {
          "file": "src/assets/apps/lesson-hub.png",
          "regex": ".",
          "flags": "s",
          "message": "Chybí ikona Lesson Hubu."
        }
      ]
    }
  ]
}
