          "action": "evaluate",
          "script": "(() => {\n const nav = document.querySelector(\".main-nav\");\n for (const [id, title] of [\n   [\"groups\",\"Moje skupiny\"],[\"report\",\"Report\"],[\"academy\",\"AI Akademie\"],\n   [\"colleague-preview\",\"Pohled kolegy\"],[\"automation\",\"Správa\"],\n   [\"demo\",\"Prezentace\"],[\"extra-test\",\"Využití AI ve škole\"]\n ]) {\n   let link = nav.querySelector('[data-nav=\"' + id + '\"]');\n   if (!link) { link = document.createElement(\"a\"); link.href = \"./\"; link.dataset.nav = id; nav.append(link); }\n   link.hidden = false;\n   link.textContent = title;\n }\n})()"
