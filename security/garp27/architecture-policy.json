{
  "schema": "garp27-architecture-policy-v1",
  "garpVersion": "2.7",
  "appId": "ai-studio",
  "appVersion": "0.21.117",
  "sourceScopes": [
    "src",
    "scripts",
    "security"
  ],
  "productionArtifacts": [
    "dist"
  ],
  "artifactStage": "prepared-deployment-dist",
  "forbiddenSourceEdges": [
    {
      "fromPrefix": "src/",
      "toPrefix": "scripts/"
    },
    {
      "fromPrefix": "src/",
      "toPrefix": "security/"
    },
    {
      "fromPrefix": "src/",
      "toPrefix": ".github/"
    },
    {
      "fromPrefix": "src/",
      "toPrefix": "vendor/"
    },
    {
      "fromPrefix": "src/",
      "toPrefix": "audit-evidence/"
    },
    {
      "fromPrefix": "src/",
      "toPrefix": "qa-results/"
    }
  ],
  "forbiddenArtifactPathPrefixes": [
    "tests/",
    "security/",
    "audit-evidence/",
    "qa-results/",
    ".github/",
    "vendor/garp-2.7-consolidated-r2/"
  ],
  "requiredFiles": [
    "package-lock.json",
    "ghrab-platform.consumer.json",
    "src/config/deployment.json",
    "src/config/deployment.school-server.json",
    "src/config/access-policy.json",
    "src/config/data-manifest.json",
    "src/config/ai-core.json",
    "src/config/ai-runtime.json",
    "src/config/release-promotion-policy.json",
    "src/access/access-control.js",
    "src/access/platform-runtime.js",
    "src/shared/material-validator.js",
    "security/garp27/garp-policy.json",
    "security/garp27/capability-inventory.json",
    "security/garp27/input-baseline.json",
    "vendor/garp-2.7-consolidated-r2/MASTER/CONTRACTS/garp27-core.json",
    "vendor/garp-2.7-consolidated-r2/MASTER/INVENTORY/ecosystem-apps.json"
  ],
  "minimumCheckedSourceFiles": 250,
  "liveServerValidationRequired": true,
  "singleAuthority": "GARP-2.7",
  "legacyAuthorities": [
    "GARP-2.5.1"
  ],
  "forbiddenArtifactFragmentParts": [
    [
      "-----BEGIN ",
      "PRIVATE KEY-----"
    ],
    [
      "-----BEGIN ",
      "ENCRYPTED PRIVATE KEY-----"
    ],
    [
      "-----BEGIN ",
      "PGP PRIVATE KEY BLOCK-----"
    ]
  ]
}
