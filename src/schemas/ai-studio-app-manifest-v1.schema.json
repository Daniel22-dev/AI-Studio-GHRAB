{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghrabuvka.cz/schemas/ai-studio-app-manifest-v1.schema.json",
  "title": "AI Studio GHRAB application manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "status",
    "description",
    "launchUrl",
    "manualUrl",
    "repository",
    "icon",
    "accent"
  ],
  "properties": {
    "schema": {
      "const": "ai-studio-app-manifest-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "name": {
      "$ref": "#/$defs/i18n"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "$ref": "#/$defs/i18n"
    },
    "description": {
      "$ref": "#/$defs/i18n"
    },
    "launchUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "repository": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/i18n"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "manualUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "aiCore": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema",
            "coreVersion",
            "contractVersion",
            "serverReady",
            "conformancePassed",
            "operationsManifestUrl"
          ],
          "properties": {
            "schema": {
              "const": "ghrab-ai-app-integration-v1"
            },
            "coreVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
            },
            "contractVersion": {
              "type": [
                "string",
                "integer"
              ]
            },
            "serverReady": {
              "type": "boolean"
            },
            "conformancePassed": {
              "type": "boolean"
            },
            "operationsManifestUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "runtimeSchema": {
              "const": "ghrab-runtime-config-v1"
            },
            "certifiedAt": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "enum": [
                "integrated-p1"
              ]
            },
            "gatewayContract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "certificationStatus": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "certificationEvidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "certifiedOperations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "schema",
            "status",
            "reason"
          ],
          "properties": {
            "schema": {
              "const": "ghrab-ai-app-integration-v1"
            },
            "status": {
              "const": "not-applicable"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "materialFlow": {
      "type": "object",
      "required": [
        "bridgeVersion",
        "importSchemas",
        "contentTypes",
        "verification"
      ],
      "properties": {
        "bridgeVersion": {
          "const": 2
        },
        "importSchemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "ghrab-material-v1"
          }
        },
        "exportSchemas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "contentTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "source-text",
              "structured-tasks"
            ]
          }
        },
        "verification": {
          "enum": [
            "disabled",
            "source-reviewed",
            "browser-verified"
          ]
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 500000
        },
        "requirements": {
          "type": "object",
          "properties": {
            "minObjectives": {
              "type": "integer",
              "minimum": 0
            },
            "minSourceChars": {
              "type": "integer",
              "minimum": 0
            },
            "minTasks": {
              "type": "integer",
              "minimum": 0
            },
            "taskTypes": {
              "type": "array",
              "items": {
                "enum": [
                  "select",
                  "truefalse",
                  "short",
                  "open",
                  "order"
                ]
              }
            },
            "oneOf": {
              "type": "array",
              "items": {
                "enum": [
                  "source-text",
                  "structured-tasks"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "cs",
        "en"
      ],
      "properties": {
        "cs": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
