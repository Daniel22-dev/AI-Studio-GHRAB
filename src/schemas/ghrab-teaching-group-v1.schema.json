{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghrabuvka.cz/schemas/ghrab-teaching-group-v1.schema.json",
  "title": "GHRAB Teaching Group v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groupId", "revision", "displayName", "schoolYear", "status", "createdAt", "updatedAt", "members"],
  "properties": {
    "schema": { "const": "ghrab-teaching-group-v1" },
    "groupId": { "type": "string", "pattern": "^grp_[A-Za-z0-9-]{12,}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "schoolYear": { "type": "string", "pattern": "^[0-9]{4}/[0-9]{2,4}$" },
    "subject": { "type": ["string", "null"], "maxLength": 80 },
    "grade": { "type": ["string", "null"], "maxLength": 40 },
    "status": { "enum": ["active", "archived"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "members": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "name", "schoolEmail", "status", "createdAt", "updatedAt"],
        "properties": {
          "memberId": { "type": "string", "pattern": "^mem_[A-Za-z0-9-]{12,}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "schoolEmail": { "type": ["string", "null"], "maxLength": 254 },
          "status": { "enum": ["active", "archived"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
